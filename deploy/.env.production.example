# Copier vers /opt/louetonmatos/.env.production sur le serveur OVH
# chmod 600 .env.production

# --- PostgreSQL (conteneur db) ---
POSTGRES_USER=louetonmatos
POSTGRES_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort
POSTGRES_DB=louetonmatos

# Hostname "db" = nom du service dans docker-compose.prod.yml
DATABASE_URL=postgresql://louetonmatos:CHANGEZ_MOI_mot_de_passe_fort@db:5432/louetonmatos?schema=public

# --- App ---
NODE_ENV=production
NEXTAUTH_URL=https://louetonmatos.fr
NEXTAUTH_SECRET=GENERER_openssl_rand_base64_32
NEXT_PUBLIC_SITE_URL=https://louetonmatos.fr

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe — voir docs/CONFIGURATION-STRIPE.md
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ENABLED=false
ALLOW_DEV_BOOKING_WITHOUT_PAYMENT=false

# Email
RESEND_API_KEY=
EMAIL_FROM=LoueTonMatos <noreply@louetonmatos.fr>

# Légal (mentions légales)
NEXT_PUBLIC_LEGAL_COMPANY_NAME=LoueTonMatos
NEXT_PUBLIC_LEGAL_FORM=SAS
NEXT_PUBLIC_LEGAL_ADDRESS=Adresse complète
NEXT_PUBLIC_LEGAL_EMAIL=contact@louetonmatos.fr
NEXT_PUBLIC_LEGAL_SIRET=
NEXT_PUBLIC_LEGAL_RCS=
NEXT_PUBLIC_LEGAL_CAPITAL=
NEXT_PUBLIC_LEGAL_DIRECTOR=
NEXT_PUBLIC_DPO_EMAIL=dpo@louetonmatos.fr
NEXT_PUBLIC_HOST_NAME=OVH SAS
NEXT_PUBLIC_HOST_ADDRESS=2 rue Kellermann, 59100 Roubaix, France

# Monitoring (optionnel)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
