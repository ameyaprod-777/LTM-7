# Copier vers /etc/nginx/sites-available/louetonmatos
# Adapter server_name et chemins SSL après certbot

upstream louetonmatos_app {
    server 127.0.0.1:3007;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name louetonmatos.fr www.louetonmatos.fr;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name louetonmatos.fr www.louetonmatos.fr;

    # Certbot remplit ces lignes après : certbot --nginx -d louetonmatos.fr
    # ssl_certificate /etc/letsencrypt/live/louetonmatos.fr/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/louetonmatos.fr/privkey.pem;

    client_max_body_size 25M;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://louetonmatos_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}
