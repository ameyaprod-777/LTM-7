{
  "name": "louetonmatos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run db:push && npm run db:seed",
    "db:setup": "npm run db:up && npm run db:push && npm run db:seed",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:baseline": "tsx prisma/baseline-migrations.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset:admin": "tsx prisma/reset-to-admin.ts",
    "db:studio": "prisma studio",
    "deploy": "bash deploy/pm2-deploy.sh",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.59.0",
    "@stripe/stripe-js": "^9.12.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "next": "14.2.35",
    "next-auth": "^4.24.14",
    "pusher": "^5.3.3",
    "pusher-js": "^8.5.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.76.0",
    "react-leaflet": "^4.2.1",
    "resend": "^6.12.3",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.1",
    "typescript": "^5"
  }
}
