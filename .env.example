# Database (Docker — voir docker-compose.yml)
DATABASE_URL="postgresql://louetonmatos:louetonmatos@localhost:5432/louetonmatos?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# OAuth Google — https://console.cloud.google.com/apis/credentials
# Type : application Web
# Origines JS : http://localhost:3000  (+ https://louetonmatos.fr en prod)
# Redirect URI : http://localhost:3000/api/auth/callback/google
#               (+ https://louetonmatos.fr/api/auth/callback/google en prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe — voir docs/CONFIGURATION-STRIPE.md (clés, webhooks, Connect, tests)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Connect Express (virements loueurs) — nécessite STRIPE_SECRET_KEY + true
STRIPE_CONNECT_ENABLED="false"
# Dev : réservations sans Stripe (true en local ; false obligatoire en prod avec paiement)
ALLOW_DEV_BOOKING_WITHOUT_PAYMENT="true"

# Email (Resend — https://resend.com/api-keys)
RESEND_API_KEY=""
# Domaine vérifié sur Resend (ex. louetonmatos.fr)
EMAIL_FROM="LoueTonMatos <support@louetonmatos.fr>"
EMAIL_REPLY_TO="support@louetonmatos.fr"
# Envoyer un email pour chaque notification in-app (sauf cas déjà gérés)
EMAIL_NOTIFICATIONS_ENABLED="true"

# KYC — géré via Stripe Identity (aucun stockage local de pièces d'identité).
# Voir docs/CONFIGURATION-STRIPE.md § Stripe Identity.
# UPLOAD_ROOT reste utile pour les autres uploads (avatars, annonces, tickets support).
# UPLOAD_ROOT="/data/uploads"

# Cron (Authorization: Bearer <secret>)
# POST /api/cron/booking-transitions — CONFIRMED → ACTIVE à la date de début
# POST /api/cron/review-reminders — relance d'avis après location
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Uploads listings (phase 2)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# Informations légales (mentions légales, pied de page)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_LEGAL_COMPANY_NAME="LoueTonMatos"
NEXT_PUBLIC_LEGAL_FORM="AUTO"
NEXT_PUBLIC_LEGAL_ADDRESS="5 rue du docteur finlay 75015 Paris"
NEXT_PUBLIC_LEGAL_EMAIL="contact@louetonmatos.fr"
NEXT_PUBLIC_LEGAL_SIRET="89368219500035"
NEXT_PUBLIC_LEGAL_RCS=""
NEXT_PUBLIC_LEGAL_CAPITAL="inconnu"
NEXT_PUBLIC_LEGAL_DIRECTOR="AMEYA Prince"
NEXT_PUBLIC_DPO_EMAIL="contact@louetonmatos.fr"

# Messagerie temps réel (Pusher — optionnel, sinon polling 5 s)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"


# ─── Sentry (monitoring erreurs) ─────────────────────────────────────────────
# Créer un projet sur https://sentry.io → Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Release affichée dans Sentry (git SHA en prod, ex. via deploy.sh)
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.05
# Upload source maps au build (CI / docker build --build-arg)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Version affichée dans GET /api/health
APP_VERSION=0.1.0